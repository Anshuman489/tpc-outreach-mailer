# Copy to .env and fill in. Relative paths resolve against the project root.

# OAuth client secret and login tokens (tokens are created on first run)
AUTH_DIR=auth
CREDENTIALS_FILE=credentials.json
TOKEN_SEND_FILE=token.json
TOKEN_BOUNCE_FILE=token_bounce.json
TOKEN_CLEANUP_FILE=token_cleanup.json

# Campaign
SHEET_PATH=data/contacts.xlsx
ATTACHMENT_PATH=data/attachment.pdf
GMAIL_LABEL=Outreach/Invitation
SENDER_NAME=Placement Cell, NIT Patna
SENDER_EMAIL=tpc.tnp@nitp.ac.in

# Tracking
STATUS_COL_INDEX=6
ONLY_TODAY=true

# Sent extraction (comma-separated)
INPUT_SHEETS=data/coordinator_a.xlsx,data/coordinator_b.xlsx
OUTPUT_SHEET=data/Sent_Combined.xlsx
